# Meta Model API Configuration (Meta Muse AI Platform)
# Get your API key from https://dev.meta.ai/api-keys
META_MODEL_API_KEY=your_meta_model_api_key_here
META_API_BASE=https://api.meta.ai/v1

# Models
DEFAULT_CHAT_MODEL=muse-spark-1.3
REASONING_MODEL=muse-wonder-1.0
SEGMENT_MODEL=sam-3.1
AUDIO_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
IMAGE_MODEL=muse-image-1.0

# Optional: WhatsApp Cloud API (developers.facebook.com)
WHATSAPP_TOKEN=your_whatsapp_cloud_api_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verify_token

# Server settings
PORT=8000
HOST=127.0.0.1
DEBUG=True
